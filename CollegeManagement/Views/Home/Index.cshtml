@{
    ViewData["Title"] = "Обзор";
}

<section class="welcome" id="overview">
    <div class="welcome-copy">
        <span class="eyebrow">РАБОЧЕЕ ПРОСТРАНСТВО КОЛЛЕДЖА</span>
        <h1>Всё важное —<br />в одном месте</h1>
        <p>Здесь постепенно появятся инструменты для управления учебным процессом. Начнём с самого необходимого.</p>
        <a class="primary-button" href="#modules">
            Посмотреть разделы
            <span aria-hidden="true">→</span>
        </a>
    </div>
    <div class="welcome-art" aria-hidden="true">
        <div class="art-orbit orbit-one"></div>
        <div class="art-orbit orbit-two"></div>
        <div class="art-card">
            <div class="art-card-top"><span></span><span></span><span></span></div>
            <div class="art-card-icon">К</div>
            <div class="art-card-line line-long"></div>
            <div class="art-card-line line-short"></div>
            <div class="art-card-bottom"><i></i><i></i><i></i></div>
        </div>
        <div class="art-spark spark-one">✳</div>
        <div class="art-spark spark-two">✦</div>
    </div>
</section>

<section class="section-heading" id="modules">
    <div>
        <span class="eyebrow">СТРУКТУРА СИСТЕМЫ</span>
        <h2>Разделы колледжа</h2>
    </div>
    <span class="section-note"><span class="status-dot"></span> Подключаем постепенно</span>
</section>

<section class="module-grid" aria-label="Разделы системы">
    <article class="module-card" id="students">
        <div class="module-icon icon-blue">01</div>
        <span class="module-status">СЛЕДУЮЩИЙ ЭТАП</span>
        <h3>Студенты</h3>
        <p>Карточки студентов, группы и основная учебная информация.</p>
        <span class="module-link">Раздел готовится <span aria-hidden="true">↗</span></span>
    </article>
    <article class="module-card" id="teachers">
        <div class="module-icon icon-violet">02</div>
        <span class="module-status">В ПЛАНАХ</span>
        <h3>Преподаватели</h3>
        <p>Состав преподавателей, дисциплины и рабочая нагрузка.</p>
        <span class="module-link">Раздел готовится <span aria-hidden="true">↗</span></span>
    </article>
    <article class="module-card" id="groups">
        <div class="module-icon icon-orange">03</div>
        <span class="module-status">В ПЛАНАХ</span>
        <h3>Учебные группы</h3>
        <p>Список групп, курсы и состав студентов.</p>
        <span class="module-link">Раздел готовится <span aria-hidden="true">↗</span></span>
    </article>
    <article class="module-card" id="attendance">
        <div class="module-icon icon-green">04</div>
        <span class="module-status">В ПЛАНАХ</span>
        <h3>Посещаемость</h3>
        <p>Учёт присутствия и сводная информация по занятиям.</p>
        <span class="module-link">Раздел готовится <span aria-hidden="true">↗</span></span>
    </article>
    <article class="module-card" id="grades">
        <div class="module-icon icon-pink">05</div>
        <span class="module-status">В ПЛАНАХ</span>
        <h3>Успеваемость</h3>
        <p>Оценки, результаты и динамика обучения.</p>
        <span class="module-link">Раздел готовится <span aria-hidden="true">↗</span></span>
    </article>
    <article class="setup-card">
        <div class="setup-mark">✦</div>
        <h3>Начинаем с основы</h3>
        <p>Сейчас это стартовый экран. Реальные данные появятся, когда подключим первый рабочий раздел.</p>
    </article>
</section>
